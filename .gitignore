.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
# Raw downloads may be copyrighted / licensed: never commit them. Keep the folder only.
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
# Processed tables derived from raw are regenerated by src/data_loader.py
data/processed/*
!data/processed/.gitkeep
# Secrets
.env
*.key
# Office lock/temp files
~$*
excel/*.xlsx
!excel/.gitkeep
# Synthetic/test chart output is never a deliverable
plots/test_*
excel/**/*.xlsx
excel/**/*.pdf
